# 依赖
node_modules/

# 构建产物
dist/
src-tauri/target/
target/

# 参考资料 / 本地资料（不入库）
.reference

# 本地临时 vendored 的第三方 pi 包（仅本机使用）
vendor/

# 本地 pi 项目设置（引用 gitignored 的 vendor 路径，不应入库）
.pi/

# 本地数据库
*.db
*.db-wal
*.db-shm

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/

# Tauri 生成的 ACL schema（每次 build 重新生成）
src-tauri/gen/schemas/

# 视觉检查的临时产物（src/preview.test.tsx 生成）
.preview/

# 库的快照（VACUUM INTO 出来的单文件，手工热备用）
# 活库跟着 exe 走（见 README「数据在哪」），所以备份放在 target/ 之外，
# 否则 `cargo clean` 会把活库和备份一起删掉。
.time-scope-backup/

